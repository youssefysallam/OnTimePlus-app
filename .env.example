# Copy this file to `.env` and fill in your secrets.
# DO NOT commit the real .env file.

# --- LLM ---
# Works with any OpenAI-compatible endpoint:
#   OpenAI         -> OPENAI_API_KEY=sk-...,            OPENAI_BASE_URL=
#   OpenRouter     -> OPENAI_API_KEY=sk-or-v1-...,      OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                     OPENAI_MODEL=openai/gpt-4o-mini   (model id MUST include provider prefix on OpenRouter)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings ---
# "openai"                -> use OPENAI_EMBED_MODEL via the same endpoint above
# "sentence_transformers" -> run a local model (works with OpenRouter, no embedding API needed)
EMBEDDING_PROVIDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-small
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Data paths ---
ONTIME_DATA_DIR=./data
ONTIME_INDEX_DIR=./data/index
